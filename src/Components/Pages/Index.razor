@page "/"
@attribute [ReaderPage("home", "/", UseBlazorRouter = true, Title = "Home")]
@namespace Encyclopedia.Components.Pages
@inject EncyclopediaDbContext Db

@using Microsoft.EntityFrameworkCore
@using Encyclopedia.Services.Database

<PageTitle>Encyclopedia</PageTitle>

<section class="home-hero">
    <h1>The Open Encyclopedia</h1>
    <p>Articles pulled live from GitHub repositories. Anyone can contribute.</p>
    <a class="cta" href="/discover">Discover wikis</a>
</section>

<section class="home-featured">
    <h2>Latest articles</h2>
    @if (_loading)
    {
        <p class="muted">Loading…</p>
    }
    else if (_dbError is not null)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertTitle>Can't reach the article index</BbAlertTitle>
            <BbAlertDescription>
                Postgres looks unreachable - start it with
                <code>docker compose up -d postgres</code> from the project
                root, then refresh. (@_dbError)
            </BbAlertDescription>
        </BbAlert>
    }
    else if (_latest.Count == 0)
    {
        <p class="muted">
            No articles indexed yet. <a href="/login">Sign in</a> and publish
            one - it'll show up here automatically.
        </p>
    }
    else
    {
        <ul class="article-list">
            @foreach (var a in _latest)
            {
                <li>
                    <a class="article-list-title" href="/wiki/@a.Identifier">@a.Title</a>
                    @if (!string.IsNullOrEmpty(a.Summary))
                    {
                        <p class="article-list-summary">@a.Summary</p>
                    }
                    <p class="article-list-meta muted">
                        from <a href="https://github.com/@a.SourceId" target="_blank" rel="noopener">@a.SourceId</a>
                        · synced @a.FetchedAt.ToString("yyyy-MM-dd")
                    </p>
                </li>
            }
        </ul>
    }
</section>

@code {
    private bool _loading = true;
    private string? _dbError;
    private List<ArticleCard> _latest = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rows = await Db.Articles
                .AsNoTracking()
                .OrderByDescending(a => a.FetchedAt)
                .Take(20)
                .Select(a => new { a.Identifier, a.Title, a.FrontmatterJson, a.SourceId, a.FetchedAt })
                .ToListAsync();

            _latest = rows.Select(r => new ArticleCard(
                r.Identifier,
                r.Title,
                ExtractSummary(r.FrontmatterJson),
                r.SourceId,
                r.FetchedAt)).ToList();
        }
        catch (Exception ex)
        {
            _dbError = ex.Message;
        }
        finally { _loading = false; }
    }

    // Pull just the summary out of the JSON to avoid deserializing the full
    // Frontmatter record (and its required-property constructor) for a list view.
    private static string? ExtractSummary(string frontmatterJson)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(frontmatterJson);
            if (doc.RootElement.TryGetProperty("summary", out var s) && s.ValueKind == System.Text.Json.JsonValueKind.String)
                return s.GetString();
        }
        catch { }
        return null;
    }

    private sealed record ArticleCard(
        string Identifier,
        string Title,
        string? Summary,
        string SourceId,
        DateTime FetchedAt);
}
